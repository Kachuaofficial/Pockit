{
  "name": "functions",
  "description": "Pockit notifications and account sync",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test test/*.test.js",
    "test:emulator": "firebase emulators:exec --project demo-pockit-commerce --config ../firebase.monetization-tests.json --only firestore \"node --test test/*.test.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^10.9.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.4.0"
  },
  "private": true,
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
