<?xml version="1.0" encoding="utf-8"?>
<!-- Platform window/splash theme before Compose renders. Compose colour and typography choices are defined in the Kotlin theme package. -->
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.Pockit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#FFE95F76</item>
        <item name="android:windowBackground">@color/pockit_cloud</item>
    </style>

    <!-- Production Splash Screen Theme using AndroidX Core SplashScreen -->
    <style name="Theme.Pockit.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pockit_cloud</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Pockit</item>
    </style>
</resources>
