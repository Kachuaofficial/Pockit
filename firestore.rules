/*
 * Server authorization policy used when these rules are deployed.
 * Client-side validation and hidden buttons are not substitutes for these allow conditions.
 * The shared-space expense rule below currently accepts any signed-in user; it is broader
 * than member-only access or recipient-only confirmation in the Android UI.
 */

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Owner-scoped profile/private paths; each nested rule below defines its permitted operations.
    match /users/{userId} {
      // Allow authenticated users to read profiles (e.g. for friend search / display names)
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /ledgerBalances/{personId} {
        allow read, write: if isOwner(userId);
      }
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
      match /balanceAdjustments/{adjustmentId} {
        allow read, create: if isOwner(userId);
      }
      match /financeRecords/{recordId} {
        allow read, write: if isOwner(userId);
      }
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      match /budgets/{budgetId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.monthlyLimitPaise is int
          && request.resource.data.monthlyLimitPaise > 0
          && request.resource.data.monthlyLimitPaise <= 100000000000;
      }
      match /subscriptions/{subscriptionId} {
        allow read, write: if isOwner(userId);
      }

      // Wallet and personal transactions: strictly private to the authenticated owner
      match /wallets/{walletId} {
        allow read, write: if isOwner(userId);
      }

      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Commerce documents are separate from client-writable finance/profile paths.
    match /coinAccounts/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
      match /ledger/{entryId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /entitlements/{feature} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /rewardDays/{day} { allow read, write: if false; }
    }
    match /offlineSyncReceipts/{receipt} { allow read, write: if false; }
    match /coinRewardSessions/{session} { allow read, write: if false; }
    match /coinRewardReceipts/{receipt} { allow read, write: if false; }
    match /commerceAccountLinks/{account} { allow read, write: if false; }
    match /playSubscriptions/{token} { allow read, write: if false; }
    match /commerceRateLimits/{userId} { allow read, write: if false; }

    // 2. Spaces collection: shared multiplayer group expense spaces
    match /spaces/{spaceId} {
      // Reads require membership; the update alternatives below also permit changes limited to membership fields.
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.memberIds);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        // Existing member or joining via invite code (adding themselves to memberIds)
        (request.auth.uid in resource.data.memberIds) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members']))
      );
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;

      // Current server boundary: any authenticated user can read/write nested expenses.
      // Recipient/member guards in the client do not narrow this allow condition.
      match /expenses/{expenseId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 3. Friendships collection: barcode / QR connected 1-to-1 friendships
    match /friendships/{friendshipId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.users);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.users);
      allow update, delete: if isAuthenticated() && (request.auth.uid in resource.data.users);
    }

    // 4. Friend transactions collection: 1-to-1 udhar and settlements
    match /friend_transactions/{txId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participantIds);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participantIds);
      allow update, delete: if isAuthenticated() && (request.auth.uid in resource.data.participantIds);
    }
  }
}
